{
  "definition": {
    "correlation": "none assumed between area and tip count; this is a declared simplification",
    "definition": "sigma_s(t) = s0 + s1 * y_s(t), fitted by least squares to the readable standard deviations of series s (rows with a non-empty sd that carry neither sd_one_sided nor sd_asymmetric_bar), and applied to every row of the series; s0 and s1 are reported per series",
    "floor": "sigma is never below the row's digitization_uncertainty column",
    "minimum_readable_rows": 15,
    "noise_multiplier": "one shared log-uniform multiplier in [0.1, 10] on sigma in stage D, as in the criticism plan",
    "pooling_rule": "a series with fewer readable rows uses the fit pooled over the other series of the same species and observable, and the report names it",
    "type": "per_series_linear_sd",
    "why_not_pointwise": "one-sided and partially hidden bar readings are biased towards shorter bars; the smooth model uses them only through the fit"
  },
