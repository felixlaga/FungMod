    given-names: Felix
    orcid: "https://orcid.org/0009-0008-8141-8172"
    affiliation: "KU Leuven, Leuven, Belgium"
repository-code: "https://github.com/felixlaga/FungMod"
url: "https://fungmod.readthedocs.io/"
license: MIT
version: 0.1.1
date-released: "2026-08-01"
keywords:
  - fungal modelling
  - enzyme kinetics
  - mechanistic modelling
  - scientific computing
  - virtual experiments
  - reproducibility
